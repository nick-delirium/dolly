{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dolly >/dev/null 2>&1 && dolly hook session-start || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dolly >/dev/null 2>&1 && dolly hook stop || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
